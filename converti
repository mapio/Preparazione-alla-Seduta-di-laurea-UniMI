#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pdfplumber", "openpyxl"]
# ///
"""
Build a per-student spreadsheet (name, thesis title, weighted average, lode count)
from the "Istruzioni seduta di laurea" attachments sent by the segreteria:
  - a Registro PDF (any name) with the student list, matricole and thesis titles
  - a "... presidente ... .zip" with one transcript PDF per student, and
    occasionally an extra Erasmus grade-increment certificate

Usage:
  ./converti <attachments_dir> [--zip ZIP] [--registro PDF] [--out OUT.xlsx]
             [--riassunti]
"""

import argparse
import glob
import os
import re
import ssl
import sys
import tempfile
import urllib.request
import zipfile

import pdfplumber
from openpyxl import Workbook
from openpyxl.styles import Alignment, Font, PatternFill
from openpyxl.utils import get_column_letter

MATR_RE = re.compile(r"^\d{6}$|^\w{5}A$")

RIASSUNTI_URL = (
    "https://www.sedutedilaurea.scienzemfn.unimi.it/view.php?matricola={matricola}"
)
RIASSUNTI_UA = "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"

ITALIAN_MONTHS = {
    "gennaio": 1,
    "febbraio": 2,
    "marzo": 3,
    "aprile": 4,
    "maggio": 5,
    "giugno": 6,
    "luglio": 7,
    "agosto": 8,
    "settembre": 9,
    "ottobre": 10,
    "novembre": 11,
    "dicembre": 12,
}


def titlecase(s):
    """Capitalize each run of letters; leaves digits, punctuation and
    apostrophes untouched so "3D" and "VULNERABILITA'" come out as
    "3D" and "Vulnerabilita'" instead of "3d" / "Vulnerabilita'S"-style
    mangling that str.title() would produce. A run right after an
    elision apostrophe stays lowercase ("Dell'attacco", not "Dell'Attacco").
    """

    def cap(m):
        word = m.group(0)
        after_elision = (
            m.start() >= 2 and s[m.start() - 1] == "'" and s[m.start() - 2].isalpha()
        )
        return word.lower() if after_elision else word[:1].upper() + word[1:].lower()

    return re.sub(r"[^\W\d_]+", cap, s, flags=re.UNICODE)


# Words the segreteria's Registro prints run together; the PDF itself is wrong.
TITLE_TYPOS = {
    "INTELLIGENZAARTIFICIALE": "INTELLIGENZA ARTIFICIALE",
    "FUNZIONICRITTOGRAFICHE": "FUNZIONI CRITTOGRAFICHE",
}


def join_title_lines(lines):
    """Join the wrapped lines of a Registro title. A line ending in a hyphen
    continues the compound word ("PROTEIN-" "LIGAND"); one ending in a lone
    L or D lost its elision apostrophe ("E L" "ANALISI" is "E L'ANALISI").
    Known run-together words of the Registro are split (TITLE_TYPOS).
    """
    title = ""
    for line in lines:
        if not title:
            title = line
        elif title.endswith("-"):
            title += line
        elif re.search(r"(?:^|\s)[LD]$", title) and line[:1] in "AEIOUÀÈÉÌÒÙ":
            title += "'" + line
        else:
            title += " " + line
    for typo, fixed in TITLE_TYPOS.items():
        title = title.replace(typo, fixed)
    return title.strip()


def full_text(path):
    text = ""
    with pdfplumber.open(path) as pdf:
        for page in pdf.pages:
            text += (page.extract_text() or "") + "\n"
    return text


def find_one(pattern, directory, label):
    matches = sorted(glob.glob(os.path.join(directory, pattern)))
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise SystemExit(
            f"Could not find a {label} matching '{pattern}' in {directory}. "
            f"Pass it explicitly with the corresponding option."
        )
    raise SystemExit(
        f"Found multiple candidates for {label} in {directory}: {matches}. "
        f"Pass the right one explicitly with the corresponding option."
    )


def find_registro(directory, explicit_path=None):
    """Identify the Registro among the top-level PDFs by content, not by
    filename: the segreteria names it "Registro ...pdf" for some corsi and
    "Verbale ...pdf" for others, but the document itself always opens with
    a "REGISTRO N. ..." header followed by "...esame di laurea".
    """
    if explicit_path:
        return explicit_path
    candidates = sorted(glob.glob(os.path.join(directory, "*.pdf")))
    matches = [p for p in candidates if is_registro(full_text(p))]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise SystemExit(
            f"Could not find a Registro PDF (containing 'REGISTRO N.' and 'esame di laurea') in {directory}. "
            f"Pass it explicitly with --registro."
        )
    raise SystemExit(
        f"Found multiple candidate Registro PDFs in {directory}: {matches}. "
        f"Pass the right one explicitly with --registro."
    )


def is_registro(text):
    return (
        bool(re.search(r"REGISTRO\s+N\.", text)) and "esame di laurea" in text.lower()
    )


def parse_session_info(reg_text):
    course = code = date_iso = None
    m = re.search(r"Corso di Laurea\s+(.+?)\(([A-Z0-9]+)\)", reg_text)
    if m:
        course = re.sub(r"\s*-\s*", " - ", m.group(1)).strip(" -")
        code = m.group(2)
    m = re.search(r"Il giorno \w+\s+(\d{1,2})\s+(\w+)\s+(\d{4})", reg_text)
    if m:
        day, month_name, year = m.groups()
        month = ITALIAN_MONTHS.get(month_name.lower())
        if month:
            date_iso = f"{year}-{month:02d}-{int(day):02d}"
    return course, code, date_iso


def parse_registro(path):
    """Parse the Registro PDF into a list of {matricola, name, title, advisor}.

    The thesis title and the "docenti" (supervisor) names sit in two
    columns that pdfplumber's linear text extraction interleaves, and
    long supervisor names wrap onto their own line indented like the
    title. Word x-position is used to tell wrapped-supervisor lines
    (indented) apart from title lines (flush with the left margin): a
    wrapped supervisor line only ever appears before the title starts,
    so once a title row has been seen for an entry, any further
    indented row would be unexpected and is ignored.

    An entry started near the bottom of a page can have its title
    continue onto the next one, so the "current" entry is tracked
    across the whole document rather than being reset per page; the
    "N / total" page-footer counter is filtered out so it doesn't get
    swept into whichever field is still open when it's encountered.
    """
    entries = []
    current = None
    with pdfplumber.open(path) as pdf:
        for page in pdf.pages:
            words = page.extract_words()
            if not words:
                continue
            rows = {}
            for w in words:
                rows.setdefault(round(w["top"], 0), []).append(w)

            for top in sorted(rows.keys()):
                row_words = sorted(rows[top], key=lambda w: w["x0"])
                texts = [w["text"] for w in row_words]
                first_x0 = row_words[0]["x0"]

                if (
                    len(texts) == 3
                    and texts[1] == "/"
                    and texts[0].isdigit()
                    and texts[2].isdigit()
                ):
                    # page-footer "N / total" counter, printed bottom-right of every page
                    continue

                if any(t == "VOTO:" for t in texts) and MATR_RE.match(texts[0]):
                    name_tokens = []
                    for t in texts[1:]:
                        if t == "VOTO:":
                            break
                        name_tokens.append(t)
                    current = {
                        "matricola": texts[0],
                        "name": " ".join(name_tokens),
                        "title": [],
                        "advisor": [],
                    }
                    entries.append(current)
                    continue

                if texts[0] == "DOCENTI":
                    tokens = texts[1:]
                    if "NOTE:" in tokens:
                        tokens = tokens[: tokens.index("NOTE:")]
                    if current is not None:
                        current["advisor"].extend(tokens)
                    continue

                if texts[0] == "LA" and "COMMISSIONE:" in texts:
                    current = None
                    continue

                if current is None:
                    continue

                if first_x0 < 40:
                    current["title"].append(" ".join(texts))
                elif not current["title"]:
                    # indented row before the title has started -> wrapped supervisor name
                    current["advisor"].extend(texts)

    for e in entries:
        e["title"] = titlecase(join_title_lines(e["title"]))
        e["name"] = " ".join(e["name"].split())
        e["advisor"] = titlecase(" ".join(e["advisor"]))
    return entries


TRANSCRIPT_MARKERS = ("VERBALE D'ESAME", "Prospetto generale degli esami superati")
ERASMUS_MARKER = "INCREMENTO DEL VOTO DI PRESENTAZIONE"


def is_transcript(text):
    return any(marker in text for marker in TRANSCRIPT_MARKERS)


def parse_transcript(text):
    """Return (matricola, avg30, avg110, lode_count) from a "libretto" transcript."""
    m = re.search(r"Matr\.\s*(\S+)", text)
    avg_m = re.search(r"Media ponderata:\s*([\d,]+)/30\s*_*\s*([\d,]+)/110", text)
    if not m or not avg_m:
        return None
    matricola = m.group(1)
    avg30 = float(avg_m.group(1).replace(",", "."))
    avg110 = float(avg_m.group(2).replace(",", "."))
    lode_count = len(re.findall(r"\b\d{2}\s+L\s+\d{2}/\d{2}/\d{4}", text))
    return matricola, avg30, avg110, lode_count


def is_erasmus_certificate(text):
    return ERASMUS_MARKER in text.upper()


def parse_erasmus_certificate(text):
    """Return (matricola, punti) from an Erasmus grade-increment certificate,
    e.g. a "-Modulo delibera erasmus incremento voto laurea...pdf" bundled in
    the same ZIP folder as the student's transcript.
    """
    m = re.search(r"matricola\s+(\w+)", text, re.IGNORECASE)
    inc_m = re.search(r"INCREMENTO TOTALE:\s*([\d,]+)\s*PUNT[OI]", text, re.IGNORECASE)
    if not m or not inc_m:
        return None
    return m.group(1), float(inc_m.group(1).replace(",", "."))


def build_workbook(students, sheet_title):
    wb = Workbook()
    wb.properties.language = "it-IT"
    ws = wb.active
    ws.title = sheet_title[:31]  # Excel sheet name limit

    headers = [
        "Cognome",
        "Nome",
        "Titolo Tesi",
        "Relatore/i",
        "Media (/30)",
        "Media (/110)",
        "N. Lodi",
        "Punti Erasmus",
        "Voto Finale",
        "Punti Commissione",
    ]
    ws.append(headers)
    for cell in ws[1]:
        cell.font = Font(bold=True)

    col_avg110 = get_column_letter(headers.index("Media (/110)") + 1)
    col_voto = get_column_letter(headers.index("Voto Finale") + 1)
    input_fill = PatternFill(
        start_color="FFF9C4", end_color="FFF9C4", fill_type="solid"
    )

    for s in students:
        row = ws.max_row + 1
        ws.append(
            [
                s["surname"],
                s["given"],
                s["title"],
                s["advisor"],
                round(s["avg30"], 3),
                round(s["avg110"], 3),
                s["lodi"],
                s["erasmus"],
            ]
        )
        erasmus_cell = ws.cell(row=row, column=headers.index("Punti Erasmus") + 1)
        voto_cell = ws.cell(row=row, column=headers.index("Voto Finale") + 1)
        voto_cell.fill = input_fill
        delta_cell = ws.cell(row=row, column=headers.index("Punti Commissione") + 1)
        delta_cell.value = (
            f'=IF({col_voto}{row}="","",{col_voto}{row}-{col_avg110}{row})'
        )
        for c in (erasmus_cell, voto_cell, delta_cell):
            c.number_format = "0.00"

    for i, w in enumerate([14, 16, 80, 24, 12, 12, 9, 13, 12, 16], start=1):
        ws.column_dimensions[chr(64 + i)].width = w

    for row in ws.iter_rows(min_row=2, max_row=ws.max_row, max_col=4):
        for cell in row:
            cell.alignment = Alignment(wrap_text=True, vertical="top")

    return wb


def download_riassunti(entries, out_dir):
    """Save each student's riassunto PDF as <matricola>.pdf in out_dir.

    The server's certificate chain does not verify and it refuses clients
    that do not look like a browser, so the connection is unverified and
    sends a Firefox User-Agent. Only public pages are read, nothing is sent.
    A student who has not uploaded a riassunto gets an HTML notice instead
    of a PDF, which is reported and not saved.
    """
    os.makedirs(out_dir, exist_ok=True)
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    for e in entries:
        url = RIASSUNTI_URL.format(matricola=e["matricola"])
        request = urllib.request.Request(url, headers={"User-Agent": RIASSUNTI_UA})
        try:
            with urllib.request.urlopen(request, context=context, timeout=30) as r:
                body = r.read()
        except OSError as err:
            print(f"  riassunto {e['matricola']}: {err}", file=sys.stderr)
            continue
        if not body.startswith(b"%PDF"):
            print(f"  riassunto {e['matricola']}: non caricato dallo studente")
            continue
        path = os.path.join(out_dir, f"{e['matricola']}.pdf")
        with open(path, "wb") as f:
            f.write(body)
        print(f"Saved: {path}")


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument(
        "attachments_dir",
        help="Folder containing the Registro PDF and the presidente ZIP",
    )
    p.add_argument(
        "--zip",
        dest="zip_path",
        help="Explicit path to the presidente ZIP (if auto-detect is ambiguous)",
    )
    p.add_argument(
        "--registro",
        dest="registro_path",
        help="Explicit path to the Registro PDF (if auto-detect is ambiguous)",
    )
    p.add_argument(
        "--out",
        dest="out_path",
        help="Output .xlsx path (default: auto-named inside attachments_dir)",
    )
    p.add_argument(
        "--riassunti",
        action="store_true",
        help="Also download each student's riassunto PDF into "
        "<attachments_dir>/riassunti (unverified TLS, see download_riassunti)",
    )
    args = p.parse_args()

    attachments_dir = os.path.abspath(args.attachments_dir)

    registro_path = find_registro(attachments_dir, args.registro_path)
    zip_path = args.zip_path or find_one("*.zip", attachments_dir, "presidente ZIP")

    reg_text = full_text(registro_path)
    registro_entries = parse_registro(registro_path)
    course, code, date_iso = parse_session_info(reg_text)

    with tempfile.TemporaryDirectory() as tmpdir:
        with zipfile.ZipFile(zip_path) as zf:
            zf.extractall(tmpdir)

        student_pdfs = sorted(
            glob.glob(os.path.join(tmpdir, "**", "*.pdf"), recursive=True)
        )
        if not student_pdfs:
            raise SystemExit(f"No PDF files found inside {zip_path}")

        transcripts = []
        erasmus_points = {}
        for fn in student_pdfs:
            text = full_text(fn)
            if is_transcript(text):
                parsed = parse_transcript(text)
                if parsed is None:
                    print(
                        f"WARNING: {fn} looks like a transcript but couldn't be parsed, skipping",
                        file=sys.stderr,
                    )
                    continue
                transcripts.append(parsed)
            elif is_erasmus_certificate(text):
                parsed = parse_erasmus_certificate(text)
                if parsed is None:
                    print(
                        f"WARNING: {fn} looks like an Erasmus certificate but couldn't be parsed, skipping",
                        file=sys.stderr,
                    )
                    continue
                matricola, punti = parsed
                erasmus_points[matricola] = punti
            else:
                print(
                    f"WARNING: {fn} doesn't look like a transcript or Erasmus certificate, skipping",
                    file=sys.stderr,
                )

        students = []
        for matricola, avg30, avg110, lodi in transcripts:
            reg = next(
                (r for r in registro_entries if r["matricola"] == matricola), None
            )
            if reg is None:
                print(
                    f"WARNING: no Registro entry for matricola {matricola}, skipping",
                    file=sys.stderr,
                )
                continue
            name_parts = reg["name"].split()
            students.append(
                {
                    "surname": titlecase(name_parts[0]),
                    "given": titlecase(" ".join(name_parts[1:])),
                    "title": reg["title"],
                    "advisor": reg["advisor"],
                    "avg30": avg30,
                    "avg110": avg110,
                    "lodi": lodi,
                    "erasmus": erasmus_points.get(matricola, 0),
                    "matricola": matricola,
                }
            )

    if not students:
        raise SystemExit(
            "No students could be matched between the Registro and the ZIP contents."
        )

    students.sort(key=lambda s: s["surname"])

    sheet_title = f"Lauree {code or ''} {date_iso or ''}".strip()
    wb = build_workbook(students, sheet_title)

    if args.out_path:
        out_path = os.path.abspath(args.out_path)
    else:
        suffix = "_".join(x for x in [code, date_iso] if x) or "lauree"
        out_path = os.path.join(attachments_dir, f"studenti_{suffix}.xlsx")

    wb.save(out_path)

    print(f"Corso: {course or '?'} ({code or '?'}) - seduta del {date_iso or '?'}")
    print(f"Saved: {out_path}")
    for s in students:
        print(
            f"  {s['surname']:14s} {s['given']:20s} avg={s['avg30']:.3f}/30 ({s['avg110']:.3f}/110) lodi={s['lodi']} erasmus={s['erasmus']:g}"
        )

    if args.riassunti:
        download_riassunti(registro_entries, os.path.join(attachments_dir, "riassunti"))


if __name__ == "__main__":
    main()
